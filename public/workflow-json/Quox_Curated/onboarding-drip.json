{
  "id": "wf-quox-onboarding-drip",
  "name": "Onboarding Drip",
  "description": "Fires when a new user signs up, sends a welcome notification immediately, then 24 hours later delivers a personalised next-steps guide generated by the assistant.",
  "source": "quox-curated",
  "category": "automation",
  "tags": ["onboarding", "welcome", "event", "drip", "assistant", "notification", "user", "personalisation"],
  "nodes": [
    {
      "id": "trig",
      "type": "trigger:event",
      "name": "User Signed Up",
      "category": "trigger",
      "config": {
        "event": "user.signed_up",
        "source": "auth",
        "filter": ""
      },
      "position": { "x": 100, "y": 300 }
    },
    {
      "id": "welcome",
      "type": "notification:deliver",
      "name": "Welcome Message",
      "category": "notification",
      "config": {
        "title": "Welcome to Quox, ${input.name}!",
        "message": "Hi ${input.name},\n\nWelcome aboard! Your workspace is ready. Explore the dashboard to connect your first agent.\n\nWe'll send a personalised guide in 24 hours.",
        "assignTo": ["${input.userId}"],
        "priority": "normal"
      },
      "position": { "x": 400, "y": 300 }
    },
    {
      "id": "wait",
      "type": "util:wait",
      "name": "Wait 24 Hours",
      "category": "utility",
      "config": {
        "duration": 86400000
      },
      "position": { "x": 700, "y": 300 }
    },
    {
      "id": "personalise",
      "type": "assistant:invoke",
      "name": "Generate Personalised Tour",
      "category": "action",
      "config": {
        "assistant_id": "corey",
        "prompt": "Generate a friendly, personalised next-steps guide for a new user named ${input.name} whose role is ${input.role || 'not specified'}. Include 3 recommended first actions for their role and 2 power tips. Keep it under 300 words, use a warm tone.",
        "name": "Generate Personalised Tour"
      },
      "position": { "x": 1000, "y": 300 }
    },
    {
      "id": "deliver-tour",
      "type": "notification:deliver",
      "name": "Deliver Tour",
      "category": "notification",
      "config": {
        "title": "Your personalised Quox guide",
        "message": "${nodes['personalise'].output.result}",
        "assignTo": ["${input.userId}"],
        "priority": "normal"
      },
      "position": { "x": 1300, "y": 300 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trig", "target": "welcome" },
    { "id": "e2", "source": "welcome", "target": "wait" },
    { "id": "e3", "source": "wait", "target": "personalise" },
    { "id": "e4", "source": "personalise", "target": "deliver-tour" }
  ],
  "meta": {
    "version": "1.0.0",
    "createdBy": "quox-curated",
    "estimatedRuntime": "24h + 30s"
  }
}

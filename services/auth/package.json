{
  "name": "quox-auth",
  "version": "1.0.0",
  "description": "Authentication and authorization service for Quox Enterprise Workspace",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node db/init.js",
    "test": "npm run test:vitest && npm run test:node && npm run test:integration && npm run test:smoke",
    "test:vitest": "vitest run",
    "test:node": "node --test --import ./test-setup.mjs tests/*.test.js routes/*.test.js",
    "test:integration": "node --test --import ./test-setup.mjs tests-integration/*.test.js",
    "test:smoke": "node --test --import ./tests-smoke/smoke-setup.mjs tests-smoke/*.test.js",
    "generate-secret": "node -e \"console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('base64url'))\""
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "adm-zip": "^0.5.16",
    "argon2": "^0.40.3",
    "better-sqlite3": "^11.6.0",
    "content-disposition": "^0.5.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "openid-client": "^6.8.3",
    "otplib": "^13.0.0",
    "qrcode": "^1.5.4",
    "ulid": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}

# Auth Service Configuration
# ===========================
# Port and host for the auth service to listen on
AUTH_PORT=3101
AUTH_HOST=0.0.0.0

# Path to SQLite database file for auth data (sessions, users, etc.)
AUTH_DB_PATH=/path/to/auth.db

# JWT Configuration
# =================
# IMPORTANT: Generate new secrets for production - never use defaults!
# Generate JWT_SECRET with: openssl rand -hex 32
# This key signs JWT tokens - compromise allows token forgery
JWT_SECRET=your-secret-here-generate-new-one

# Token expiry times (use short access tokens, longer refresh tokens)
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Environment
# ===========
# Set to 'production' in production environments
NODE_ENV=development

# CORS Configuration
# ==================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Encryption Key for Sensitive Settings
# =====================================
# Used to encrypt API keys and secrets stored in the database
# Generate with: openssl rand -base64 32
# CRITICAL: If this key is lost, encrypted data cannot be recovered
MASTER_ENCRYPTION_KEY=your-encryption-key-here-generate-new-one

# QuoxBastion Configuration (for CIPHER/NOVA agent tools)
# =======================================================
# URL of the QuoxBastion SSH proxy service
BASTION_URL=http://your-bastion-host:9850

# API token for authenticating with QuoxBastion (leave empty if not using)
BASTION_API_TOKEN=

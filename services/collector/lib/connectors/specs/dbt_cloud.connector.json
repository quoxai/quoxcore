    {
      "name": "list_jobs",
      "description": "List the job definitions on one dbt Cloud account, optionally narrowed to a single project (get the IDs from list_accounts and list_projects). Definitions only: no job is triggered",
      "input_schema": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "dbt Cloud account ID (from list_accounts)"
          },
          "project_id": {
            "type": "number",
            "description": "Optional dbt Cloud project ID to filter by (from list_projects)"
          },
          "limit": {
            "type": "number",
            "description": "Max jobs to return (default 20, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Optional number of jobs to skip, for paging"
          }
        },
        "required": [
          "account_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/accounts/{{input.account_id}}/jobs/",
        "query": {
          "project_id": "{{input.project_id}}",
          "limit": "{{clamp input.limit 20 100}}",
          "offset": "{{input.offset}}"
        }
      },
      "response": {
        "pick": {
          "data[]": {
            "id": "id",
            "name": "name",
            "account_id": "account_id",
            "project_id": "project_id",
            "environment_id": "environment_id",
            "description": "description",
            "dbt_version": "dbt_version",
            "state": "state",
            "generate_docs": "generate_docs",

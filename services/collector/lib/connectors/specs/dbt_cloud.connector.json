        },
        "truncate": 2000
      }
    },
    {
      "name": "list_runs",
      "description": "List job runs on one dbt Cloud account, newest first, optionally narrowed to a single job definition (get the IDs from list_accounts and list_jobs). Returns status, git ref and timings per run",
      "input_schema": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "dbt Cloud account ID (from list_accounts)"
          },
          "job_definition_id": {
            "type": "number",
            "description": "Optional dbt Cloud job ID to filter by (from list_jobs)"
          },
          "limit": {
            "type": "number",
            "description": "Max runs to return (default 20, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Optional number of runs to skip, for paging"
          }
        },
        "required": [
          "account_id"

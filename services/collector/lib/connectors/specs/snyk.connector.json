      "name": "list_orgs",
      "description": "List the Snyk organizations the API token can see",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max organizations per page (default 20, max 100; Snyk requires at least 10)"
          },
          "slug": {
            "type": "string",
            "description": "Optional exact organization slug to filter by"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/rest/orgs",
        "query": {
          "version": "2024-10-15",
          "limit": "{{clamp input.limit 20 100}}",
          "slug": "{{input.slug}}"
        }
      },
      "response": {
        "pick": {
          "data[]": {
            "id": "id",
            "name": "attributes.name",
            "slug": "attributes.slug",
            "group_id": "attributes.group_id",
            "is_personal": "attributes.is_personal",
            "created_at": "attributes.created_at"
          },
          "next": "links.next"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "list_projects",
      "description": "List the projects monitored by one Snyk organization",
      "input_schema": {
        "type": "object",
        "properties": {
          "org_id": {
            "type": "string",

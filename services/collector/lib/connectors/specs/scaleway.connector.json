  "tools": [
    {
      "name": "list_projects",
      "description": "List the Projects of one Scaleway Organization, with their names, IDs and creation dates",
      "input_schema": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string",
            "description": "Scaleway Organization ID the Projects belong to (UUID, required by the Project API)"
          },
          "page_size": {
            "type": "number",
            "description": "Max Projects to return per page (default 20, max 100)"
          },
          "name": {
            "type": "string",
            "description": "Optional Project name to filter by"
          }
        },
        "required": [
          "organization_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/account/v3/projects",
        "query": {
          "organization_id": "{{input.organization_id}}",
          "page_size": "{{clamp input.page_size 20 100}}",
          "name": "{{input.name}}"
        }
      },
      "response": {
        "pick": {
          "projects[]": {
            "id": "id",
            "name": "name",
            "organization_id": "organization_id",
            "description": "description",
            "created_at": "created_at",

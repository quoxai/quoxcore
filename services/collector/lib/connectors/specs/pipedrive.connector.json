    {
      "name": "list_deals",
      "description": "List Pipedrive deals, optionally filtered by status",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max deals to return (default 20, max 50)"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "won",
              "lost",
              "deleted",
              "all_not_deleted"
            ],
            "description": "Optional deal status to filter by"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/deals",
        "query": {
          "limit": "{{clamp input.limit 20 50}}",
          "status": "{{input.status}}"
        }
      },
      "response": {
        "pick": {
          "data[]": {
            "id": "id",
            "title": "title",
            "value": "value",
            "currency": "currency",
            "status": "status",
            "stage_id": "stage_id",
            "add_time": "add_time",
            "update_time": "update_time"
          },
          "more_items": "additional_data.pagination.more_items_in_collection"
        },
        "truncate": 2000
      }
    },
    {
      "name": "get_deal",
      "description": "Get one Pipedrive deal by its numeric ID",
      "input_schema": {
        "type": "object",
        "properties": {

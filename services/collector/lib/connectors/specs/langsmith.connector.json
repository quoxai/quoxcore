      "input_schema": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string",
            "description": "LangSmith dataset UUID"
          },
          "limit": {
            "type": "number",
            "description": "Max examples to return (default 10, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Number of examples to skip for pagination (default 0)"
          },
          "splits": {
            "type": "string",
            "description": "Optional dataset split name to filter by (e.g. base)"
          }

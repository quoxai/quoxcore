  "tools": [
    {
      "name": "list_projects",
      "description": "List LangSmith tracing projects (tracer sessions) in the workspace the API key belongs to, newest activity first",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max projects to return (default 20, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Number of projects to skip for pagination (default 0)"
          },
          "name_contains": {
            "type": "string",
            "description": "Optional substring filter on the project name"
          },
          "include_stats": {
            "type": "boolean",
            "description": "Include run counts, latency, token and cost aggregates (slower)"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/sessions",
        "query": {
          "limit": "{{clamp input.limit 20 100}}",
          "offset": "{{input.offset}}",
          "name_contains": "{{input.name_contains}}",
          "include_stats": "{{input.include_stats}}"
        }
      },
      "response": {
        "pick": {
          "[]": {
            "id": "id",
            "name": "name",
            "description": "description",
            "start_time": "start_time",
            "last_run_start_time": "last_run_start_time",
            "run_count": "run_count",
            "error_rate": "error_rate",
            "latency_p50": "latency_p50",
            "total_tokens": "total_tokens",
            "total_cost": "total_cost",
            "reference_dataset_id": "reference_dataset_id"
          }
        },
        "truncate": 2000
      }
    },
    {
      "name": "get_project",
      "description": "Get one LangSmith tracing project by its session ID, with optional run count, latency, token and cost stats",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "LangSmith project (tracer session) UUID"
          },
          "include_stats": {
            "type": "boolean",
            "description": "Include run counts, latency, token and cost aggregates (slower)"
          }
        },
        "required": [
          "project_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/sessions/{{input.project_id}}",
        "query": {
          "include_stats": "{{input.include_stats}}"
        }
      },
      "response": {
        "pick": {
          "id": "id",
          "name": "name",
          "description": "description",
          "start_time": "start_time",
          "end_time": "end_time",
          "last_run_start_time": "last_run_start_time",
          "run_count": "run_count",
          "error_rate": "error_rate",
          "latency_p50": "latency_p50",
          "latency_p99": "latency_p99",
          "total_tokens": "total_tokens",
          "total_cost": "total_cost",
          "reference_dataset_id": "reference_dataset_id"
        },
        "truncate": 2000
      }
    },
    {
      "name": "list_datasets",
      "description": "List LangSmith evaluation datasets in the workspace, with example and experiment counts",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max datasets to return (default 20, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Number of datasets to skip for pagination (default 0)"
          },
          "name_contains": {
            "type": "string",
            "description": "Optional substring filter on the dataset name"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "kv",
              "llm",
              "chat"
            ],
            "description": "Optional dataset data type filter"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/datasets",
        "query": {
          "limit": "{{clamp input.limit 20 100}}",
          "offset": "{{input.offset}}",
          "name_contains": "{{input.name_contains}}",
          "data_type": "{{input.data_type}}"
        }
      },
      "response": {
        "pick": {
          "[]": {
            "id": "id",
            "name": "name",
            "description": "description",
            "data_type": "data_type",
            "example_count": "example_count",
            "session_count": "session_count",
            "created_at": "created_at",
            "modified_at": "modified_at",
            "last_session_start_time": "last_session_start_time"
          }
        },
        "truncate": 2000

          },
          "limit": {
            "type": "number",
            "description": "Max branches to return (default 20, max 100; the API itself allows 1 to 10000)"
          },
          "search": {
            "type": "string",
            "description": "Optional partial branch name or id to filter by"
          }
        },
        "required": [
          "project_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/projects/{{input.project_id}}/branches",
        "query": {

          }
        },
        "required": [
          "monitor_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/monitor/{{input.monitor_id}}"
      },
      "response": {
        "pick": {
          "id": "id",
          "name": "name",
          "type": "type",
          "overall_state": "overall_state",
          "query": "query"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "list_dashboards",
      "description": "List Datadog dashboards available to the organization",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/dashboard"
      },
      "response": {
        "pick": {
          "dashboards[]": {
            "id": "id",
            "title": "title",
            "url": "url"
          }
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "list_events",
      "description": "List Datadog events in a time window (unix seconds)",
      "input_schema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "description": "Window start, POSIX timestamp in seconds"
          },
          "end": {
            "type": "number",
            "description": "Window end, POSIX timestamp in seconds"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/events",
        "query": {

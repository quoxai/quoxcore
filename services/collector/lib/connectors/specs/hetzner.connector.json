    {
      "name": "list_servers",
      "description": "List Hetzner Cloud servers, optionally filtered by status or exact name",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number",
            "description": "Max servers to return (default 25, max 50)"
          },
          "status": {
            "type": "string",
            "enum": [
              "initializing",
              "starting",
              "running",
              "stopping",
              "off",
              "deleting",
              "rebuilding",
              "migrating",
              "unknown"
            ],
            "description": "Optional server status to filter by"
          },
          "name": {
            "type": "string",
            "description": "Optional exact server name to filter by"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/servers",
        "query": {
          "per_page": "{{clamp input.per_page 25 50}}",
          "status": "{{input.status}}",
          "name": "{{input.name}}"
        }
      },
      "response": {
        "pick": {
          "servers[]": {
            "id": "id",
            "name": "name",
            "status": "status",
            "created": "created",
            "public_ipv4": "public_net.ipv4.ip",
            "public_ipv6": "public_net.ipv6.ip",
            "server_type": "server_type.name",
            "cores": "server_type.cores",
            "memory": "server_type.memory",
            "disk": "server_type.disk",
            "datacenter": "datacenter.name",
            "city": "datacenter.location.city",
            "image": "image.name",
            "locked": "locked"
          },
          "total": "meta.pagination.total_entries"
        },
        "truncate": 2000
      }
    },
    {

          }
        },
        "required": [
          "team_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/teams/{{input.team_id}}/projects"
      },
      "response": {
        "pick": {
          "name": "name",
          "projects[]": {
            "id": "id",

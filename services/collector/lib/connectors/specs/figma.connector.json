          }
        },
        "required": [
          "file_key"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/files/{{input.file_key}}",
        "query": {
          "depth": "1"
        }
      },
      "response": {
        "pick": {
          "name": "name",
          "lastModified": "lastModified",
          "version": "version"
        },
        "truncate": 2000
      }
    },
    {
      "name": "get_file_comments",
      "description": "List comments on one Figma file",
      "input_schema": {
        "type": "object",
        "properties": {

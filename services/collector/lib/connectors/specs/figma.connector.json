          }
        },
        "required": [
          "file_key"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/files/{{input.file_key}}/comments"
      },
      "response": {
        "pick": {
          "comments[]": {
            "id": "id",
            "message": "message",
            "created_at": "created_at",
            "resolved_at": "resolved_at",
            "user": "user.handle",
            "parent_id": "parent_id"
          }
        },
        "truncate": 2000
      }
    },
    {
      "name": "list_team_projects",

      "name": "list_documents",
      "description": "List PandaDoc documents, optionally filtered by search text, status, template or folder",
      "input_schema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "Max documents to return (default 20, max 100)"
          },
          "page": {
            "type": "number",
            "description": "1-based page of results to return (default 1)"
          },
          "q": {
            "type": "string",
            "description": "Optional search text matched against the document name"
          },
          "status": {
            "type": "string",
            "description": "Optional PandaDoc document status filter, passed through unchanged (see the List Documents reference for the accepted values)"
          },
          "template_id": {
            "type": "string",
            "description": "Optional template ID to return only documents created from that template"
          },
          "folder_uuid": {
            "type": "string",
            "description": "Optional document folder UUID to list, from list_document_folders"
          },
          "order_by": {
            "type": "string",
            "description": "Optional sort field, e.g. name, date_created, date_modified, date_completed; prefix with '-' to reverse"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/public/v1/documents",
        "query": {
          "count": "{{clamp input.count 20 100}}",

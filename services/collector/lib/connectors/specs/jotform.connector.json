      "description": "List the forms on the JotForm account, with title, status and submission counts",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max forms to return (default 20, max 100)"
          },
          "offset": {
            "type": "number",
            "description": "Optional start of the result set, for pagination (default 0)"
          },
          "orderby": {
            "type": "string",
            "enum": [
              "id",
              "username",
              "title",

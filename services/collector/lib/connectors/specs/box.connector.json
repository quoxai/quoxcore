    {
      "name": "list_folder_items",
      "description": "List the files and folders inside one Box folder (use folder_id 0 for the root folder)",
      "input_schema": {
        "type": "object",
        "properties": {
          "folder_id": {
            "type": "string",
            "description": "Box folder ID, or 0 for the root folder"
          },
          "limit": {
            "type": "number",
            "description": "Max items to return (default 20, max 50)"
          },
          "offset": {
            "type": "number",
            "description": "Offset into the item list for paging (default 0)"
          }
        },
        "required": [
          "folder_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/2.0/folders/{{input.folder_id}}/items",
        "query": {
          "limit": "{{clamp input.limit 20 50}}",
          "offset": "{{input.offset}}",
          "fields": "id,type,name,size,modified_at"
        }
      },
      "response": {
        "pick": {
          "entries[]": {
            "id": "id",
            "type": "type",
            "name": "name",
            "size": "size",

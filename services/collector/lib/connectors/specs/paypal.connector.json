    {
      "name": "list_transactions",
      "description": "List PayPal account transactions in a date window (Transaction Search API, max 31 days per call)",
      "input_schema": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "Window start, ISO 8601 with offset (e.g. 2026-09-01T00:00:00-0000)"
          },
          "end_date": {
            "type": "string",
            "description": "Window end, ISO 8601 with offset (e.g. 2026-09-30T23:59:59-0000). Must be within 31 days of start_date"
          },
          "transaction_status": {
            "type": "string",
            "enum": [
              "D",
              "P",
              "S",
              "V"
            ],
            "description": "Optional status filter: D denied, P pending, S success, V reversed"
          },
          "page_size": {
            "type": "number",
            "description": "Max transactions per page (default 20, max 500)"
          }
        },
        "required": [
          "start_date",
          "end_date"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/reporting/transactions",
        "query": {
          "start_date": "{{input.start_date}}",
          "end_date": "{{input.end_date}}",
          "transaction_status": "{{input.transaction_status}}",
          "page_size": "{{clamp input.page_size 20 500}}",
          "fields": "transaction_info"
        }
      },
      "_probe": {
        "input.start_date": "2026-09-01T00:00:00-0000",
        "input.end_date": "2026-09-02T00:00:00-0000"
      },
      "response": {
        "pick": {
          "transaction_details[]": {
            "transaction_id": "transaction_info.transaction_id",
            "status": "transaction_info.transaction_status",
            "initiation_date": "transaction_info.transaction_initiation_date",
            "amount": "transaction_info.transaction_amount.value",
            "currency": "transaction_info.transaction_amount.currency_code",
            "note": "transaction_info.transaction_note"
          },
          "total_items": "total_items",
          "total_pages": "total_pages"
        },
        "truncate": 2000
      }
    },
    {
      "name": "list_invoices",
      "description": "List PayPal invoices, newest page first",
      "input_schema": {
        "type": "object",
        "properties": {
          "page_size": {
            "type": "number",
            "description": "Max invoices to return (default 20, max 100)"
          },
          "page": {
            "type": "number",
            "description": "1-based page number to return (default 1)"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/invoicing/invoices",
        "query": {
          "page_size": "{{clamp input.page_size 20 100}}",
          "page": "{{clamp input.page 1 100}}",
          "total_required": "true"
        }
      },
      "response": {
        "pick": {
          "items[]": {
            "id": "id",
            "status": "status",
            "invoice_number": "detail.invoice_number",
            "invoice_date": "detail.invoice_date",
            "currency": "detail.currency_code",
            "due_amount": "due_amount.value",

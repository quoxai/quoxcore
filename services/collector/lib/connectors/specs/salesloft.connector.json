      "description": "List Salesloft people (contacts), optionally filtered to one email address",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max people to return per page (default 25, max 100)"
          },
          "page": {
            "type": "number",
            "description": "Page number to fetch (1-based, default 1)"
          },
          "email": {
            "type": "string",
            "description": "Optional exact email address to filter by"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/people.json",
        "query": {
          "per_page": "{{clamp input.limit 25 100}}",
          "page": "{{input.page}}",
          "email_addresses[]": "{{input.email}}"
        }
      },
      "response": {
        "pick": {
          "data[]": {
            "id": "id",

    {
      "name": "list_instances",
      "description": "List Vultr cloud compute instances, optionally filtered by region or label",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number",
            "description": "Max instances to return (default 20, max 100)"
          },
          "region": {
            "type": "string",
            "description": "Optional Vultr region id to filter by (e.g. ewr)"
          },
          "label": {
            "type": "string",
            "description": "Optional exact instance label to filter by"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/instances",
        "query": {
          "per_page": "{{clamp input.per_page 20 100}}",
          "region": "{{input.region}}",
          "label": "{{input.label}}"
        }
      },
      "response": {
        "pick": {
          "instances[]": {
            "id": "id",
            "label": "label",
            "hostname": "hostname",
            "os": "os",
            "region": "region",
            "plan": "plan",
            "status": "status",
            "power_status": "power_status",
            "server_status": "server_status",
            "main_ip": "main_ip",
            "vcpu_count": "vcpu_count",
            "ram": "ram",
            "disk": "disk",
            "date_created": "date_created"
          },
          "total": "meta.total"
        },
        "truncate": 2000
      }
    },
    {
      "name": "get_instance",
      "description": "Get one Vultr instance by ID",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "description": "Vultr instance ID (a UUID, e.g. cb676a46-66fd-4dfb-b839-443f2e6c0b60)"
          }
        },
        "required": [
          "instance_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v2/instances/{{input.instance_id}}"
      },
      "response": {
        "pick": {

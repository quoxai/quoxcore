      "name": "list_transactions",
      "description": "List transactions on one Brex cash account (get the account_id from list_accounts)",
      "input_schema": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Brex cash account ID to read transactions for (from list_accounts)"
          },
          "limit": {
            "type": "number",
            "description": "Max transactions to return (default 20, max 100)"
          },
          "posted_at_start": {
            "type": "string",
            "description": "Optional ISO 8601 date-time; only transactions posted at or after this point are returned"
          }
        },
        "required": [
          "account_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v2/transactions/cash/{{input.account_id}}",
        "query": {
          "limit": "{{clamp input.limit 20 100}}",
          "posted_at_start": "{{input.posted_at_start}}"
        }
      },
      "response": {
        "pick": {
          "items[]": {

            "description": "Optional branch name to filter pipelines by (e.g. main)"
          }
        },
        "required": [
          "project_slug"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/project/{{input.project_slug}}/pipeline",

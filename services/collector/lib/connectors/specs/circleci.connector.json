      },
      "response": {
        "pick": {
          "items[]": {
            "id": "id",
            "number": "number",
            "state": "state",
            "created_at": "created_at",
            "updated_at": "updated_at",
            "branch": "vcs.branch",
            "revision": "vcs.revision",
            "trigger_type": "trigger.type",
            "triggered_by": "trigger.actor.login"
          },
          "next_page_token": "next_page_token"
        },
        "truncate": 2000
      },
      "write": false,
      "_probe": {
        "input.project_slug": "gh/CircleCI-Public/api-preview-docs",

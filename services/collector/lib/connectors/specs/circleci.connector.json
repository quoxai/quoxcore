            "type": "string",
            "description": "CircleCI pipeline id (UUID, e.g. 5034460f-c7c4-4c43-9457-de07e2029e7b)"
          }
        },
        "required": [
          "pipeline_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/pipeline/{{input.pipeline_id}}"
      },
      "response": {
        "pick": {
          "id": "id",
          "number": "number",
          "project_slug": "project_slug",
          "state": "state",
          "created_at": "created_at",
          "updated_at": "updated_at",
          "branch": "vcs.branch",
          "revision": "vcs.revision",
          "trigger_type": "trigger.type",
          "triggered_by": "trigger.actor.login"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "list_workflows",
      "description": "List the workflows belonging to one CircleCI pipeline, with their current status",
      "input_schema": {
        "type": "object",
        "properties": {
          "pipeline_id": {
            "type": "string",
            "description": "CircleCI pipeline id (UUID, e.g. 5034460f-c7c4-4c43-9457-de07e2029e7b)"
          }
        },
        "required": [
          "pipeline_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/pipeline/{{input.pipeline_id}}/workflow"
      },
      "response": {
        "pick": {
          "items[]": {
            "id": "id",
            "name": "name",
            "status": "status",
            "project_slug": "project_slug",
            "pipeline_number": "pipeline_number",
            "started_by": "started_by",
            "created_at": "created_at",
            "stopped_at": "stopped_at"
          },
          "next_page_token": "next_page_token"
        },
        "truncate": 2000
      },
      "write": false
    }

  "tools": [
    {
      "name": "get_me",
      "description": "Get the CircleCI user account that owns the configured API token",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/me"
      },
      "response": {
        "pick": {
          "id": "id",
          "login": "login",
          "name": "name"
        },
        "truncate": 2000

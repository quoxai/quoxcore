    {
      "name": "list_pipelines",
      "description": "List recent CircleCI pipelines for one project, newest first, optionally filtered to a branch",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_slug": {
            "type": "string",
            "description": "CircleCI project slug in the form vcs/org/repo (e.g. gh/CircleCI-Public/api-preview-docs)"

          "until": {
            "type": "string",
            "description": "Optional end of the window, ISO date (YYYY-MM-DD) or Unix timestamp"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1.0/me/threads",
        "query": {
          "fields": "id,media_product_type,media_type,permalink,username,text,timestamp,shortcode,is_quote_post,has_replies",
          "limit": "{{clamp input.limit 20 100}}",

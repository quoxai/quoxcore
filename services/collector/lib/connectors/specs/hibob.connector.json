            "description": "HiBob employee ID"
          },
          "policy_type": {
            "type": "string",
            "description": "Policy type name, as returned by list_time_off_policy_types (e.g. Holiday)"
          },
          "date": {
            "type": "string",
            "description": "Point in time to report the balance as of (YYYY-MM-DD)"
          }
        },
        "required": [
          "employee_id",
          "policy_type",
          "date"
        ]
      },
      "request": {
        "method": "GET",

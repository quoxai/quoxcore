    {
      "name": "get_time_off_balance",
      "description": "Get one HiBob employee's time off balance for a policy type at a point in time (starting balance, taken, adjustments, annual allowance)",
      "input_schema": {
        "type": "object",
        "properties": {
          "employee_id": {

    {
      "name": "whos_out",
      "description": "List who is out of the office in HiBob across a date range (employee, policy type, status, dates and day portions)",
      "input_schema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Start of the period (YYYY-MM-DD)"
          },
          "to": {
            "type": "string",
            "description": "End of the period (YYYY-MM-DD)"
          },
          "include_pending": {
            "type": "boolean",
            "description": "Include pending requests as well as approved ones (default false)"
          },
          "include_hourly": {
            "type": "boolean",
            "description": "Include hourly requests, not just whole or part days (default false)"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/timeoff/whosout",
        "query": {
          "from": "{{input.from}}",
          "to": "{{input.to}}",
          "includePending": "{{input.include_pending}}",
          "includeHourly": "{{input.include_hourly}}"
        }

    {
      "name": "list_leave_requests",
      "description": "List Rippling leave requests, optionally filtered by employee role, status, leave policy, exact leave dates or an overlapping date range",
      "input_schema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",

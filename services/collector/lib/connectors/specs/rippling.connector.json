          },
          "from": {
            "type": "string",
            "description": "Optional range start (YYYY-MM-DD): returns requests overlapping from..to"
          },
          "to": {
            "type": "string",
            "description": "Optional range end (YYYY-MM-DD): returns requests overlapping from..to"
          },
          "limit": {

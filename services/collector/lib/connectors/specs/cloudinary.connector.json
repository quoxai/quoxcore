  "auth": {
    "type": "basic",
    "userField": "api_key",
    "passField": "api_secret"
  },
  "test": {
    "method": "GET",
    "path": "/usage"
  },
  "tools": [
    {
      "name": "list_resources",
      "description": "List uploaded Cloudinary image assets, newest first, one page at a time",
      "input_schema": {
        "type": "object",
        "properties": {
          "max_results": {
            "type": "number",
            "description": "Max assets to return (default 10, max 50)"
          },
          "next_cursor": {
            "type": "string",
            "description": "Optional pagination cursor returned as next_cursor by a previous call"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/resources/image",
        "query": {
          "max_results": "{{clamp input.max_results 10 50}}",
          "next_cursor": "{{input.next_cursor}}"
        }
      },
      "response": {
        "pick": {
          "resources[]": {
            "public_id": "public_id",
            "format": "format",
            "version": "version",
            "resource_type": "resource_type",
            "type": "type",
            "created_at": "created_at",
            "bytes": "bytes",
            "width": "width",
            "height": "height",
            "secure_url": "secure_url"
          },
          "next_cursor": "next_cursor"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "usage",
      "description": "Get the Cloudinary account's plan and current usage: credits, storage, bandwidth, transformations and object counts",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "request": {
        "method": "GET",
        "path": "/usage"
      },
      "response": {
        "pick": {
          "plan": "plan",
          "last_updated": "last_updated",
          "credits_usage": "credits.usage",
          "credits_limit": "credits.limit",
          "credits_used_percent": "credits.used_percent",
          "storage_usage": "storage.usage",
          "storage_credits_usage": "storage.credits_usage",
          "bandwidth_usage": "bandwidth.usage",
          "bandwidth_credits_usage": "bandwidth.credits_usage",
          "transformations_usage": "transformations.usage",
          "transformations_credits_usage": "transformations.credits_usage",
          "objects_usage": "objects.usage",
          "requests": "requests",
          "resources": "resources",
          "derived_resources": "derived_resources"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "list_folders",
      "description": "List the root-level asset folders in the Cloudinary product environment",
      "input_schema": {
        "type": "object",
        "properties": {
          "max_results": {
            "type": "number",
            "description": "Max folders to return (default 10, max 50)"
          },
          "next_cursor": {
            "type": "string",
            "description": "Optional pagination cursor returned as next_cursor by a previous call"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/folders",
        "query": {
          "max_results": "{{clamp input.max_results 10 50}}",
          "next_cursor": "{{input.next_cursor}}"
        }
      },
      "response": {
        "pick": {
          "folders[]": {
            "name": "name",
            "path": "path",
            "external_id": "external_id"
          },
          "total_count": "total_count",
          "next_cursor": "next_cursor"
        },
        "truncate": 2000
      },
      "write": false
    }
  ],
  "_scaffold": {

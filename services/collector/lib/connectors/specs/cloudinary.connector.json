{
  "spec_version": 1,
  "id": "cloudinary",
  "name": "Cloudinary",
  "category": "media",
  "credentialType": "cloudinary",
  "requiredFields": [
    "cloud_name",
    "api_key",
    "api_secret"
  ],
  "docs": "https://cloudinary.com/documentation/admin_api",

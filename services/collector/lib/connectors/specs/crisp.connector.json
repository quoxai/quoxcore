        },
        "required": [
          "website_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/website/{{input.website_id}}/people/stats"
      },
      "response": {
        "pick": {
          "total": "data.total",
          "reason": "reason"
        },
        "truncate": 2000

  "tools": [
    {
      "name": "list_conversations",
      "description": "List conversations for one Crisp website (first page), newest activity first",
      "input_schema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "description": "Crisp website identifier (UUID, from the Crisp dashboard URL)"
          },
          "per_page": {
            "type": "number",
            "description": "Page size for conversations paging (between 20 and 50, default 20)"
          },
          "search_query": {
            "type": "string",
            "description": "Optional search query (plain text when search_type is text)"
          },
          "search_type": {
            "type": "string",
            "enum": [
              "text",
              "segment",
              "filter"
            ],
            "description": "Optional search type applied to search_query"
          }
        },
        "required": [
          "website_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/website/{{input.website_id}}/conversations/1",
        "query": {
          "per_page": "{{clamp input.per_page 20 50}}",
          "search_query": "{{input.search_query}}",
          "search_type": "{{input.search_type}}"
        }
      },
      "response": {
        "pick": {
          "data[]": {
            "session_id": "session_id",
            "people_id": "people_id",
            "state": "state",
            "status": "status",
            "availability": "availability",
            "is_verified": "is_verified",
            "last_message": "last_message",
            "nickname": "meta.nickname",
            "email": "meta.email",
            "unread_operator": "unread.operator",
            "created_at": "created_at",
            "updated_at": "updated_at"
          },
          "reason": "reason"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "get_conversation",
      "description": "Get one Crisp conversation by session ID, with its state, visitor metadata and last message",
      "input_schema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "description": "Crisp website identifier (UUID, from the Crisp dashboard URL)"
          },
          "session_id": {
            "type": "string",
            "description": "Crisp conversation session identifier (e.g. session_aaea8e1d-d6e3-4238-9252-d8c2e5579f5c)"
          }
        },
        "required": [
          "website_id",
          "session_id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/website/{{input.website_id}}/conversation/{{input.session_id}}"
      },
      "response": {
        "pick": {
          "session_id": "data.session_id",
          "website_id": "data.website_id",
          "people_id": "data.people_id",
          "state": "data.state",
          "status": "data.status",
          "availability": "data.availability",
          "is_verified": "data.is_verified",
          "is_blocked": "data.is_blocked",
          "last_message": "data.last_message",
          "nickname": "data.meta.nickname",
          "email": "data.meta.email",
          "segments": "data.meta.segments",
          "unread_operator": "data.unread.operator",
          "created_at": "data.created_at",
          "updated_at": "data.updated_at"
        },
        "truncate": 2000
      },
      "write": false
    },
    {
      "name": "get_people_stats",
      "description": "Get the number of people stored in one Crisp website's CRM",
      "input_schema": {
        "type": "object",

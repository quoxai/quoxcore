{
  "spec_version": 1,
  "id": "unsplash",
  "name": "Unsplash",
  "category": "media",
  "credentialType": "unsplash",
  "requiredFields": [
    "access_key"
  ],
  "docs": "https://unsplash.com/documentation",
  "base_url": "https://api.unsplash.com",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "template": "Client-ID {{access_key}}"
  },
  "static_headers": {
    "Accept-Version": "v1"
  },
  "test": {
    "method": "GET",
    "path": "/photos",
    "query": {

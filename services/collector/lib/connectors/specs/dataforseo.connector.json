    {
      "name": "serp_google_organic_live",
      "description": "Fetch live Google organic search results for one keyword in a given location and language, returning ranked organic items with position, domain, title, URL and snippet",
      "input_schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Search term to look up (e.g. self-hosted agent platform)"
          },
          "location_code": {
            "type": "number",
            "description": "DataForSEO location code (e.g. 2840 United States, 2826 United Kingdom, 2276 Germany)"
          },
          "language_code": {
            "type": "string",
            "description": "DataForSEO language code (e.g. en, de, fr)"
          },
          "depth": {
            "type": "number",
            "description": "Number of results to crawl (default 10, max 100). Higher depth costs more."
          }
        },
        "required": [
          "keyword",
          "location_code",
          "language_code"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/v3/serp/google/organic/live/advanced",
        "body": [
          {
            "keyword": "{{input.keyword}}",
            "location_code": "{{input.location_code}}",
            "language_code": "{{input.language_code}}",
            "depth": "{{clamp input.depth 10 100}}"
          }
        ]
      },
      "response": {
        "pick": {
          "status_code": "status_code",
          "status_message": "status_message",
          "cost": "cost",
          "tasks[]": {
            "id": "id",
            "status_code": "status_code",
            "status_message": "status_message",
            "result[]": {
              "keyword": "keyword",
              "location_code": "location_code",
              "language_code": "language_code",
              "check_url": "check_url",
              "datetime": "datetime",
              "se_results_count": "se_results_count",
              "items_count": "items_count",
              "items[]": {
                "type": "type",
                "rank_group": "rank_group",
                "rank_absolute": "rank_absolute",
                "domain": "domain",
                "title": "title",
                "url": "url",
                "description": "description",
                "breadcrumb": "breadcrumb"
              }
            }
          }
        },
        "truncate": 2000

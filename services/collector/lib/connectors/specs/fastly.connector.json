      "name": "list_services",
      "description": "List Fastly services on the account, with their type and most recent update time",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number",
            "description": "Max services to return (default 20, max 100)"
          },
          "page": {
            "type": "number",
            "description": "Optional 1-based page number to fetch"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/service",
        "query": {
          "per_page": "{{clamp input.per_page 20 100}}",
          "page": "{{input.page}}"
        }
      },
      "response": {
        "pick": {
          "[]": {
            "id": "id",
            "name": "name",
            "type": "type",
            "customer_id": "customer_id",
            "comment": "comment",
            "created_at": "created_at",
            "updated_at": "updated_at"
          }
        },
        "truncate": 2000
      }
    },

# Quox Collector Service Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# SERVER
# =============================================================================
COLLECTOR_PORT=9848
NODE_ENV=development  # Set to 'production' for production deployments

# =============================================================================
# GLOBAL RATE LIMIT (quox#598) — backstop, not a throttle on real use
# =============================================================================
# Applies to (almost) every route, mounted right after the auth gate. Two
# buckets: per-IP (unauthenticated flood) and per-org (a single authenticated
# org hammering across many IPs; only applied when a verified org exists).
# Exempt regardless of these values: health/readiness, CORS preflight,
# INTERNAL_SERVICE_KEY-authenticated service calls, and long-lived SSE/
# streaming connections (/chat/stream, /chat/stream-mock, /voice/speak/stream,
# and any POST with { stream: true }).
# Defaults are generous — well above the sum of the existing per-route
# buckets (chat 30/min, tool 60/min, task 100/min, ...) — so legitimate
# dashboard/agent traffic should never trip this.
COLLECTOR_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
COLLECTOR_GLOBAL_RATE_LIMIT_MAX_PER_IP=1200
COLLECTOR_GLOBAL_RATE_LIMIT_MAX_PER_ORG=3000
# Set to 'true' only for local debugging of a false-positive throttle; leave
# unset/false in every deployed environment.
COLLECTOR_GLOBAL_RATE_LIMIT_DISABLED=false

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database for AEE envelope storage
AEE_DB_PATH=/var/lib/quox/aee.db

# =============================================================================
# ENCRYPTION - CRITICAL FOR SECURITY
# =============================================================================
# Master key for encrypting sensitive envelope data (payload and raw fields)
# This protects user prompts and conversation content at rest.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: Without this key, a derived key will be used (less secure)
# WARNING: Changing this key will make existing encrypted data unreadable
MASTER_ENCRYPTION_KEY=

# =============================================================================
# PRIVACY OPTIONS
# =============================================================================
# Set to 'true' to completely disable transcript storage
# When enabled, no envelope data is written to the database
# This is useful for highly sensitive deployments
DISABLE_TRANSCRIPT_STORAGE=false

# =============================================================================
# VOLT (server-side evidence capture — quox#510)
# =============================================================================
# Safety bound, not a feature toggle: VOLT capture from the AEE stream is
# always on for workflow-run (wf-*) correlations. This caps how many VOLT
# events a single run can write (a runaway loop node or retry storm is
# bounded, not the trace itself) — mirrors the per-event size bounds already
# hardcoded in lib/voltEmitter.js. Default: 2000.
QUOX_VOLT_MAX_EVENTS_PER_RUN=2000

# =============================================================================
# BACKEND INTEGRATIONS
# =============================================================================
# Perplexity API for research queries (Oracle agent)
PERPLEXITY_API_KEY=

# OpenAI API for code-focused queries (Codex agent)
OPENAI_API_KEY=

# Google Gemini API for image generation (GEMINI agent)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# JWT (if validating tokens from auth service)
# =============================================================================
# Should match the auth service JWT_SECRET for token validation
JWT_SECRET=

# SKILLRIGHTS #478 Phase 9 — env FALLBACK only; the real surface is the
# org-settable DEV_SKILLPACK_DISTRIBUTION_POLICY setting (Settings UI /
# platformSettingsStore). allow | require-declaration | respect-reserved
# DEV_SKILLPACK_DISTRIBUTION_POLICY=allow

# =============================================================================
# FEED host-path allowlist (BRAIN2-V3 A1)
# =============================================================================
# BRAIN2-W2 1: roots are bound to orgs. Entry forms (CSV, mixable):
#   <orgId>:/abs/path   usable ONLY by that org (admin PUT and scheduler walk)
#   /abs/path           bare instance root: usable only by service-key callers
#                       or when QUOXFEED_ORGS lists exactly ONE org. On a
#                       multi-org instance tenants cannot use bare roots.
# Malformed entries are ignored (fail closed).
# CSV of absolute directories. Org-admin PUT /api/feed/sources/:type configs
# that name a host path (folder, docs roots, automemory memoryDir, transcript,
# obsidian, git) must realpath inside one of these. UNSET = fail closed for
# JWT callers (service-key callers may set any path). Walks also skip any
# symlink escaping its root. Dev instance value:
# FEED_FOLDER_ALLOWED_ROOTS=<orgId>:/opt/quoxcore/docs,<orgId>:/opt/quoxcore/quox-website/docs,<orgId>:/opt/quoxcore/.quoxfeed/automemory-staging
FEED_FOLDER_ALLOWED_ROOTS=

# Brain2 retrieval and privacy switches (BRAIN2-V3 B4)
# These are NOT env-only: an org admin sets them in Settings > Brain2 (audited);
# a stored org setting overrides these env defaults. The collector only reads
# QUOXBRAIN_IMPLANT_ENABLED; the rest are read by the quoxbrain service, which
# resolves the stored setting first and falls back to its own env.
#   QUOXBRAIN_IMPLANT_ENABLED       inject [KNOWLEDGE CONTEXT] into agent prompts (default false)
#   QUOXDREAM_ENABLED               QuoxDream consolidation (restart needed)
#   QUOXDREAM_ALLOW_LLM_TEXT        false = never send note text to the LLM for consolidation
#   QUOXBRAIN_MIN_COVERAGE / QUOXBRAIN_MIN_DENSE_COSINE / QUOXBRAIN_MIN_DENSE_FLOOR   abstention thresholds
#   QUOXBRAIN_QUERY_EMBED_TIMEOUT_MS   interactive query embed bound (default 1500)
#   QUOXBRAIN_EMBED_EXCLUDE_VAULTS  comma-separated vault names/ids never sent to the embedding provider

# ApprovalsQ (QVOICE-OUTBOUND #521): phone a human about STALE HITL approvals.
# Never approves anything. OFF unless QUOX_APPROVALSQ_WATCHER is truthy; per-org
# policy (enabled, thresholds, quiet hours) lives in plugin_storage under
# plugin_id=quox-voice key=approvalsq.policy and is OFF by default per org too.
QUOX_APPROVALSQ_WATCHER=
# QUOX_APPROVALSQ_INTERVAL_MS=60000
# QUOX_APPROVALSQ_WARMUP_MS=90000
# Voice bridge (loopback :3112 on the HOST). The collector runs in a container, so
# its 127.0.0.1 is NOT the host: the URL must be reachable from inside the
# container (docker-compose defaults to http://host.docker.internal:3112 and maps
# host-gateway via extra_hosts). Fully configurable for other deployments.
# QUOX_TELEPHONY_BRIDGE_URL=http://host.docker.internal:3112
# X-Quox-Trigger secret for the bridge (same value the bridge holds).
# TELEPHONY_TRIGGER_SECRET=
# Where the host bridge POSTs the call outcome back (defaults to http://127.0.0.1:9848).
# QUOX_APPROVALSQ_CALLBACK_BASE=

# CLI-QUOX session continuity (quox client turns on the Claude CLI path).
# A stored CLI session idle longer than this many hours starts fresh (default 24).
# CLI_RESUME_MAX_IDLE_HOURS=24
# Start fresh when the last turn's context reached this percent of the model window (default 80).
# CLI_RESUME_MAX_CONTEXT_PCT=80

# QUOXON-LATENCY L2: warm `claude` spares on the CLI-tools path. After a turn, the collector
# boots the conversation's next `claude` process ahead of time (about 3 to 4 s of boot moved
# off the next turn). One spare per conversation, single use, never shared across users or
# orgs, no credential in its env (the turn token arrives per turn via a 0600 file).
# Each idle spare holds about 200 MB RSS. Per-turn state: cli_warm in [TurnTiming] summary.
# QUOX_CLI_WARM=1             # 0 = off (every turn spawns cold, the previous behaviour)
# QUOX_CLI_WARM_TTL_MS=180000 # idle spare is killed after this
# QUOX_CLI_WARM_MAX=4         # most spares alive at once (oldest evicted)
# quox#1151 boot re-warm: pairs active in the TTL window before a restart get spares again
# QUOX_CLI_WARM_BOOT_DELAY_MS=20000   # settle delay after boot before re-warming
# QUOX_CLI_WARM_BOOT_STAGGER_MS=5000  # pause between boot spares (one at a time)
# QUOX_CLI_WARM_BOOT_MAX_LOAD=20      # skip boot re-warm while 1-min load is above this
# QUOX_CLI_WARM_RECIPES_PATH=/var/lib/quox/cli-warm-recipes.json  # credential-free recipes (0600)
# QUOX_CLI_WARM_ONESHOT=1    # 0 = a /chat/stream turn without turn_id (plain `quox chat`) runs one-shot json again: never warm

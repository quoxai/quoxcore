# Server
PORT=3000

# Database (optional outside production - uses in-memory if not set; empty
# string counts as unset). In production, boot fails fast without this set
# unless QUOXFLOW_ALLOW_MEMORY_STORES=true (TRUST-GATE 1.1, not recommended).
DATABASE_URL=postgresql://user:pass@localhost:5432/quoxflow

# Evidence storage path (optional - uses /tmp/quoxflow/evidence if not set)
EVIDENCE_PATH=/var/lib/quoxflow/evidence

  "policies": {
    "maxBudgetTokens": 500000,
    "maxBudgetToolCalls": 200,
    "maxDurationMs": 28800000,
    "maxTaskDurationMs": 1800000,
    "heartbeatIntervalMs": 15000,
    "maxParallelTasks": 3,
    "requireApprovalBeforeStart": true,
    "checkpointAfterEachTask": false,
    "voltRequired": true,
    "allowedChannels": ["slack", "telegram", "discord", "email"]
  },

  "sharedContext": {
    "persistent": true,
    "schema": {}
  }

  "recipes": [
    {
      "id": "server-health-monitor",
      "name": "Server Health Monitor",
      "description": "Monitor CPU, memory, and disk usage on hosts with multi-channel alerting",
      "category": "monitoring",
      "triggers": ["schedule"],
      "estimatedNodes": 5,
      "questions": [
        {
          "key": "hosts",
          "question": "Which hosts should be monitored?",
          "type": "multi_select",
          "options": ["all_docker", "all_proxmox", "all_monitoring", "specific"],
          "default": "all_docker"
        },
        {
          "key": "metrics",
          "question": "What metrics should be checked?",
          "type": "multi_select",
          "options": ["cpu", "memory", "disk", "load"],
          "default": ["cpu", "memory", "disk"]
        },
        {
          "key": "cpu_threshold",
          "question": "CPU alert threshold (%)?",
          "type": "number",
          "default": 90
        },
        {
          "key": "memory_threshold",
          "question": "Memory alert threshold (%)?",
          "type": "number",
          "default": 85
        },
        {
          "key": "disk_threshold",
          "question": "Disk alert threshold (%)?",
          "type": "number",
          "default": 90
        },
        {
          "key": "interval",
          "question": "Check interval?",
          "type": "select",
          "options": ["1 minute", "5 minutes", "15 minutes", "1 hour"],
          "default": "5 minutes"
        },
        {
          "key": "notification_channels",
          "question": "Where should alerts go?",
          "type": "multi_select",
          "options": ["telegram", "email", "inbox", "slack"],
          "default": ["telegram", "inbox"]
        }
      ],
      "template": {
        "triggerType": "schedule",
        "nodes": ["schedule_trigger", "http_request", "if_condition", "notification"]
      }
    },

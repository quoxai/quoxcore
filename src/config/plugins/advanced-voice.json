  "configSchema": {
    "defaultVoice": {
      "type": "string",
      "enum": [
        "21m00Tcm4TlvDq8ikWAM",
        "pNInz6obpgDQGcFmaJgB",
        "VR6AewLTigWG4xSOukaG",
        "onwK4e9ZLuTAKqWW03F9"
      ],
      "enumLabels": {
        "21m00Tcm4TlvDq8ikWAM": "Rachel (American Female)",
        "pNInz6obpgDQGcFmaJgB": "Adam (American Male)",
        "VR6AewLTigWG4xSOukaG": "Arnold (American Male)",
        "onwK4e9ZLuTAKqWW03F9": "Daniel (British Male)"
      },
      "default": "onwK4e9ZLuTAKqWW03F9",
      "label": "Default Voice",
      "description": "The voice used when no specific voice is requested"
    },
    "stability": {
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5,
      "label": "Stability",
      "description": "Voice consistency (0 = more expressive variation, 1 = more consistent)"
    },
    "similarityBoost": {
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.75,
      "label": "Similarity Boost",
      "description": "How closely the voice matches the original character (0 = loose, 1 = strict)"
    },
    "style": {
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5,
      "label": "Style Exaggeration",
      "description": "Voice expressiveness intensity (0 = neutral, 1 = highly expressive)"
    },
    "enableSmartSummarization": {
      "type": "boolean",
      "default": true,
      "label": "Smart Summarization",
      "description": "Use AI to intelligently summarize long responses for speech instead of truncating"
    }
  },

  "name": "advanced-voice",
  "version": "1.0.0",
  "displayName": "Advanced Voice",
  "tagline": "Rich voice, built in.",
  "description": "The full voice experience, included in core: 40+ professional ElevenLabs voices, fine-tuned voice parameters, intelligent summarization, and extended speech limits. No activation, no charge.",
  "shortDescription": "40+ voices, voice parameters, smart summarization, 2000 char TTS limit — all free.",
  "author": "QUOX",
  "license": "free",
  "price": 0,
  "priceDisplay": "Free",
  "priceModel": "free",
  "tier": "free",
  "featured": false,

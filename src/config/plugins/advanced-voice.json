  "infoUrl": "https://quox.ai/plugins/advanced-voice",
  "docsUrl": "https://quox.ai/docs/plugins/advanced-voice",
  "heroGradient": "linear-gradient(135deg, #38bdf8 0%, #a78bfa 50%, #f472b6 100%)",
  "accentColor": "#38bdf8",
  "marketingPoints": [
    "40+ professional ElevenLabs voices to choose from",
    "Fine-tune stability, similarity, style, and speed",
    "AI-powered smart summarization for long responses",
    "2000 character TTS limit",
    "Assign unique voices to each agent personality"
  ],
  "features": {
    "voiceLibrary": {
      "name": "Extended Voice Library",
      "description": "Access 40+ professional ElevenLabs voices including male, female, accents, and character voices. Find the perfect voice for each agent.",
      "icon": "users",
      "highlight": true
    },
    "voiceParameters": {
      "name": "Voice Parameter Control",
      "description": "Fine-tune voice settings: stability (consistency), similarity boost (character matching), style (expressiveness), and speed (1.0x-1.5x).",
      "icon": "sliders",
      "highlight": true
    },
    "smartSummarization": {
      "name": "AI Smart Summarization",
      "description": "Long responses are intelligently summarized for speech instead of truncated. Preserves meaning while reducing length.",
      "icon": "brain",
      "highlight": true
    },
    "extendedLimit": {
      "name": "2000 Character TTS Limit",
      "description": "A generous 2000-character speech limit, included in core.",
      "icon": "maximize"
    },
    "voicePreview": {
      "name": "Voice Preview & Testing",
      "description": "Preview any voice before assigning it. Test with custom phrases to find the perfect fit.",
      "icon": "play"
    },
    "voiceExport": {
      "name": "Voice Config Export/Import",
      "description": "Save and share your voice configurations. Back up your settings or transfer to another instance.",
      "icon": "download"
    }
  },
  "comparison": {
    "free": {
      "name": "Free",
      "voices": "4 built-in",
      "parameters": "None",
      "ttsLimit": "500 chars",
      "summarization": "Truncation only",
      "preview": false,
      "export": false
    },
    "premium": {
      "name": "Premium",
      "voices": "40+ voices",
      "parameters": "Full control",
      "ttsLimit": "2000 chars",
      "summarization": "AI-powered",
      "preview": true,
      "export": true
    }
  },
  "limits": {
    "free": {
      "maxVoices": 4,
      "maxTTSLength": 500,
      "voiceParameters": false,
      "smartSummarization": false
    },
    "premium": {
      "maxVoices": -1,
      "maxTTSLength": 2000,
      "voiceParameters": true,
      "smartSummarization": true
    }
  },

# QuoxCORE Configuration
# Copy this file to .env and customize as needed
# The installer script generates secrets automatically

# ============================================
# REQUIRED - Security Keys
# Generate with: openssl rand -hex 32 (for hex keys)
# Or run: ./scripts/generate-secrets.sh
# ============================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
# QuoxVault master encryption key (AES-256-GCM) — REQUIRED, no fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=CHANGE_ME_generate_base64_32_bytes

# ============================================
# PORTS
# ============================================
DASHBOARD_PORT=3000
AUTH_PORT=3101
FILES_PORT=3102
COLLECTOR_PORT=9848
QDRANT_PORT=6333

# ============================================
# DOCKER - Host-specific configuration
# Auto-detected by generate-secrets.sh
# ============================================
# DOCKER_GID=988

# ============================================
# OPTIONAL - API Keys
# Add these for full AI functionality
# ============================================

# Anthropic - Powers Claude AI conversations
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI - Chat models, routing, and embeddings
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs - Text-to-speech (voice output)
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Stripe - Plugin purchases (if running store)
# Get key at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ============================================
# OPTIONAL - Demo Mode
# Run without API keys for evaluation
# ============================================
VITE_DEMO_MODE=false

# ============================================
# SSL/TLS Configuration
# ============================================
# Certificate mode: selfsigned, letsencrypt, or manual
SSL_MODE=selfsigned

# Let's Encrypt settings (required if SSL_MODE=letsencrypt)
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=
# Use staging server for testing (certificates won't be trusted)
LETSENCRYPT_STAGING=false

# ============================================
# REQUIRED - PostgreSQL (QuoxFlow database)
# ============================================
POSTGRES_DB=quoxflow
POSTGRES_USER=quoxflow
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_PORT=5432

# ============================================
# OPTIONAL - QuoxFlow Configuration
# ============================================
QUOXFLOW_PORT=3200
QUOXFLOW_AUTH_ENABLED=true
# Service-to-service key for collector → QuoxFlow internal calls
# IMPORTANT: INTERNAL_SERVICE_KEY and WEBSITE_SERVICE_KEY MUST be different values
INTERNAL_SERVICE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# ScreenCap → quox-website upload key (must differ from INTERNAL_SERVICE_KEY)
WEBSITE_SERVICE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Approval gate for destructive operations (stop/reboot/shutdown)
QUOXFLOW_APPROVAL_ENABLED=true

# Engine Validation Suite (STUDY-REV-2 P8.E) — nightly synthetic-agent test
# battery (tb-1..tb-6: echo baseline, policy-gated, echo-crystal, budget-bound,
# trigger-interleave, cross-tenant) that exercises the full AOCL pipeline and
# persists a NightlyReport via /api/validation. Runs at 03:00 UTC when enabled
# (quoxflow/src/validation/scheduler.ts). Unset/false (default) = suite never
# runs; the "N nights green" gate used by downstream migration streams (e.g.
# BQ-AGENTIC-MIGRATION) can never be satisfied until this is turned on.
# NOTE: enabling this in an actual environment is a deploy/ops decision, not
# a default — it has never run in this environment, so its first nights may
# surface findings that need triage before being trusted as a gate. Also note
# docker-compose.yml's quoxflow service does not currently forward this var
# into the container; wiring that through is part of the same deploy decision.
# QUOXFLOW_VALIDATION_SUITE=true

# SEC-PLUGIN-TRUST H2: /aee/store, /aee/sync, /aee/query auth enforcement.
# Default (unset/false) = LOG-ONLY: unauthenticated requests are logged as
# "would reject" but still processed unchanged — nothing breaks. Set to
# "true" only after confirming all internal callers (auth, screencap, tasks)
# send a valid x-service-key or JWT (see docs/STREAM_SEC_PLUGIN_TRUST_PLAN.md H2).
AEE_ENDPOINT_AUTH_ENFORCE=false

# ============================================
# SECURITY ENFORCEMENT POSTURE (LICENSE-LAUNCH LL-6b)
# ============================================
# Three gates are switched here, two of them OFF by default:
#
#   COLLECTOR_AUTH_ENFORCE     'enforce' | 'shadow' (default)
#                              shadow LOGS would-deny and lets the request
#                              through, so the collector's default-deny gate is
#                              decorative until this reads exactly 'enforce'.
#   AEE_ENDPOINT_AUTH_ENFORCE  'true' | anything else (default log-only), above.
#   QUOXCHAT_LICENSE_ENFORCE   'off' disables the QuoxChat widget licence gate.
#                              Anything else (including unset) enforces.
#
# WITH NODE_ENV=production, a gate switched off here is ENFORCED ANYWAY unless
# an instance admin has opened an unexpired break-glass record. Records carry a
# reason, are attributed to the account that opened them, and expire after at
# most 72 hours. Outside production the values above are obeyed as written.
#
#   Dashboard:  Settings -> Security -> Enforcement
#   CLI:        quox admin enforcement list
#               quox admin enforcement break-glass COLLECTOR_AUTH_ENFORCE \
#                 --reason "fleet key rollout in flight" --hours 4
#               quox admin enforcement clear COLLECTOR_AUTH_ENFORCE
#
# Code: services/auth/lib/breakGlass.js (record + resolver, canonical) and
# services/collector/lib/enforcementPosture.js (the collector's mirror).
# COLLECTOR_AUTH_ENFORCE=shadow
# QUOXCHAT_LICENSE_ENFORCE=on

# ============================================
# OPTIONAL - Notifications
# Configure channels for send_notification tool
# ============================================
# NOTIFICATION_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# NOTIFICATION_TELEGRAM_TOKEN=bot_token
# NOTIFICATION_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# NOTIFICATION_SMTP_HOST=
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASS=
# NOTIFICATION_SMTP_FROM=

# ============================================
# REQUIRED - Qdrant Authentication
# API key protects the vector database
# Generate with: openssl rand -hex 32
# ============================================
QDRANT_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# Frontend service URLs (proxy paths for production)
# These MUST use proxy paths, not localhost ports,
# so remote browsers can reach the services
# ============================================
VITE_MEMORY_SERVICE_URL=/api/memory
VITE_QDRANT_URL=/qdrant
# WARNING: any VITE_* var is inlined into the built frontend JS and shipped to
# every browser. Leave blank — Qdrant access goes through the same-origin
# /qdrant proxy above, which needs no client-side key. Setting a real key
# here exposes it to every visitor.
VITE_QDRANT_API_KEY=

# ============================================
# OPTIONAL - JWT Token Expiry
# ============================================
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ============================================
# OPTIONAL - Cookie Security
# ============================================
# Set to true for HTTPS deployments, false for HTTP (default: false)
# When true, browsers will only send cookies over secure connections
COOKIE_SECURE=false

# Data Retention (Security Issue #73): now DB-driven instance config,
# managed via /api/admin/retention/config (services/auth/routes/retention.js),
# not env vars. The old DEFAULT_RETENTION_DAYS / RETENTION_AUDIT_EVENTS_DAYS /
# RETENTION_SESSIONS_DAYS / RETENTION_SYSTEM_LOGS_DAYS / RETENTION_CLEANUP_ENABLED
# / RETENTION_CLEANUP_HOUR keys are no longer read by any code; removed here.

# ============================================
# CORS Origins (auto-detected by generate-secrets.sh)
# Add all URLs users will access the dashboard from
# ============================================
# CORS_ORIGINS=https://your-ip:3000,https://localhost:3000

# ============================================
# OPTIONAL - Infrastructure Connections
# Configure these if you have monitoring/infrastructure tools
# Leave blank if not applicable — the UI will show setup guides
# ============================================

# SSH Bastion — gateway for infrastructure tool access
# BASTION_HOST=
# BASTION_URL=
# BASTION_API_TOKEN=

# Collector's own externally reachable address (fleet #431). Stamped into
# dev-loop spawn envelopes (managed hosts POST turn batches back to it) and
# templated into GET /install. REQUIRED for dev-loop / self-managing
# instances: there is deliberately no default. Use an address a MANAGED HOST
# can reach (LAN IP or public DNS of this collector, port 9848), never a
# container-internal name.
# COLLECTOR_LAN_URL=http://<this-collector-host>:9848
# COLLECTOR_PUBLIC_URL=

# Grafana — dashboard embedding and alert monitoring
# GRAFANA_URL=
# GRAFANA_API_KEY=

# Prometheus — metrics collection
# PROMETHEUS_URL=

# Alertmanager: alerts tools (active alerts, silences). Fallback only: the
# server-side setting wins. Set it with: quox settings set ALERTMANAGER_URL <url>
# (http or https, e.g. http://alertmanager:9093). quox#1061
# ALERTMANAGER_URL=

# Uptime Kuma — service availability monitoring
# UPTIME_KUMA_URL=

# Proxmox VE — virtualisation cluster management
# PROXMOX_URL=
# PROXMOX_API_TOKEN=

# MikroTik RouterOS — the collector only talks HTTPS (www-ssl) to a router whose identity it can verify.
# With no pin and no CA bundle NO request (and no credentials) is sent. Read the router's fingerprint with
# `quox router trust --show`, compare it out of band, then set the pin yourself (never auto-pinned). quoxai/quox#1236
# MIKROTIK_TLS_PIN=            # SHA-256 of the router's TLS leaf cert (or its public key), hex, comma separated
# MIKROTIK_CA_FILE=            # alternative: PEM CA bundle that signed the router cert (pin wins if both set)
# MIKROTIK_INSECURE_DEV=       # DEV ONLY: 1 allows UNVERIFIED plain http:// to the router; warns on every call

# Wazuh SIEM — security monitoring (optional)
# WAZUH_HOST=
# WAZUH_API_PORT=55000
# WAZUH_API_USER=wazuh-wui
# WAZUH_API_PASSWORD=

# Google Gemini — alternative LLM provider
# GEMINI_API_KEY=

# ============================================
# OPTIONAL - MCP Tools
# Enable AI agents to use infrastructure tools via MCP protocol
# ============================================
MCP_TOOLS_ENABLED=true

# ============================================
# OPTIONAL - Additional LLM Providers
# ============================================
# Perplexity — web-search-augmented AI
# PERPLEXITY_API_KEY=

# ============================================
# OPTIONAL - Wazuh Indexer (Elasticsearch-compatible)
# Only needed if using Wazuh SIEM with custom indexer queries
# ============================================
# WAZUH_INDEXER_USER=admin
# WAZUH_INDEXER_PASSWORD=

# ============================================
# OPTIONAL - Chat Integrations
# Bot tokens for receiving messages via Slack, Discord, Telegram
# ============================================
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# TELEGRAM_WEBHOOK_SECRET=

# ============================================
# OPTIONAL - Plugin Licensing
# Comma-separated list of activated plugin IDs
# Managed via /admin page — no manual editing needed
# ============================================
# LICENSED_PLUGINS=

# ============================================
# OPTIONAL - Screencap Service
# Automated screenshot capture (behind --profile with-screencap)
# ============================================
# SCREENCAP_EMAIL=
# SCREENCAP_PASSWORD=
# SCREENCAP_ORG_ID=
# SCREENCAP_SCHEDULE_HOURS=168
# WEBSITE_API_URL=https://api.quox.ai

# ============================================
# OPTIONAL - Backup Configuration
# ============================================
# BACKUP_ROOT=/opt/quoxcore/backups

# ============================================
# OPTIONAL - Advanced / Internal
# These have sensible defaults — only change if you know what you're doing
# ============================================
# NODE_ENV=production
# QUOXCORE_VERSION=0.0.0
# GITHUB_REPO=quoxai/quox
# SSH_KEYS_PATH=./ssh-keys
# COMPOSE_PROJECT_DIR=/opt/quoxcore
# SCHEDULER_POLL_MS=5000
# CSRF_PROTECTION=true

# ============================================
# WARD "Quox Verified" sink (LICENSE-LAUNCH LL-9)
# Countersigns this instance's WARD tip digests with the quox.ai control plane.
# NO-ENV-ONLY-CONFIG: the primary switch is a server-side setting an instance
# admin toggles at Settings > Instance > Licensing (stored as instance_config
# key licensing.quox_verified.enabled). This env flag is only the fallback
# DEFAULT for when that setting is unset; the dashboard value WINS when set.
# ============================================
# WARD_QUOX_VERIFIED_ENABLED=0

# Additional service ports (rarely need changing)
# MEMORY_PORT=3103
# TASKS_PORT=3104
# ORCHESTRATOR_PORT=3100

# ============================================
# REPOSITORY PATHS (for AI tool execution)
# The collector service volume-mounts quoxmcp for MCP protocol tools.
# setup.sh clones these automatically if missing.
# ============================================
# QUOXMCP_PATH=/opt/quoxcore/quoxmcp
# QUOXMCP_DEPLOY_PATH=/opt/quoxcore/quoxmcp/deploy
# QUOXFLOW_PATH=../quoxflow

# ============================================
# SEALED SKILLS (SKILLRIGHTS #478 Phase 14, sealed execution pilot)
# AES-256-GCM key (64 hex chars) encrypting sealed skill methodologies at
# rest. It is its OWN key with its own purpose: never reuse the org crystal
# signing key or any other existing secret here. Generate with:
#   openssl rand -hex 32
# Unset or malformed = the sealed routes answer 503 sealed_unavailable. There
# is deliberately no fallback that stores a methodology in the clear.
#
# NO-ENV-ONLY-CONFIG: both rate limits are registered capabilities with a
# Settings surface (SEALED_INVOKE_RATE_PER_HOUR, default 30, per skill; and
# SEALED_INVOKE_ORG_RATE_PER_HOUR, default 100, across the whole org); the env
# vars below are only the instance DEFAULTS and the stored org setting wins.
#
# HONEST LIMIT, binding on every surface: sealed execution keeps the text of
# your methodology out of the calling model's context; the executing model and
# its provider DO see it, under that provider's data terms, and nothing here
# prevents someone who can call the capability from learning what it does.
# (Superseded 2026-09-11 by external audit: the previous wording here claimed
# "every model's context and every provider's training pipeline", which the
# execution path contradicts.)
# ============================================
# SEALED_CONTENT_KEY=
# SEALED_INVOKE_RATE_PER_HOUR=30
# SEALED_INVOKE_ORG_RATE_PER_HOUR=100

# --- InboxQ ---
# Master kill-switch for the InboxQ background sync scheduler (operator-level).
# 0 (default) = scheduler DARK, manual sync only; 1 = scheduler runs. Per-mailbox
# auto-sync is controlled by the dashboard setting (inboxq_settings.sync_enabled,
# default off), so setting this to 1 syncs nothing until an org opts in.
INBOXQ_SYNC_ENABLED=0

# ApprovalsQ (QVOICE-OUTBOUND #521): stale-approval phone escalation, OFF by default.
# See services/collector/.env.example. Bridge URL must be reachable from the collector container.
QUOX_APPROVALSQ_WATCHER=
QUOX_APPROVALSQ_CALLBACK_BASE=

# QUOXON-PROOF: proof board data.json the conversation reads (proof_status tool). Non-secret.
# QUOX_PROOF_BOARD_URL=http://192.0.2.126:4350/data.json
